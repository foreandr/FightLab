extends SceneTree
var failures: Array[String]=[]
func _initialize() -> void:call_deferred("run")
func check(value: bool,message: String) -> void:
	if not value:
		failures.append(message)
		push_error(message)
func frames(count: int) -> void:
	for i in count:await physics_frame
func run() -> void:
	var lab=load("res://scenes/combat_sandbox.tscn").instantiate()
	root.add_child(lab)
	lab.camera_input_enabled=false
	check(lab.chain_chips.is_empty() and lab.chosen_steps().is_empty(),"Animations must start with a genuinely empty chain")
	check(lab.chain_steps.find_children("*","OptionButton",true,false).is_empty(),"Chain must not contain catalog dropdowns")
	lab.select_category("Dash")
	lab.library_add_buttons.Dash.pressed.emit()
	lab.select_group("Attack")
	lab.select_category("Knee")
	lab.library_add_buttons.Knee.pressed.emit()
	lab.library_add_buttons.Knee.pressed.emit()
	check(lab.chosen_steps()==["Dash","Knee","Knee"] and lab.chain_chips.size()==3,"Library plus must append exactly the chosen animation and preserve duplicates")
	lab.chain_remove_buttons[1].pressed.emit()
	check(lab.chosen_steps()==["Dash","Knee"],"Individual remove must delete the chosen middle step")
	lab.remove_step_button.pressed.emit()
	check(lab.chosen_steps()==["Dash"],"Minus must remove the last step")
	lab.set_chain(["Jump","Flip","Land","Dash","Punch","Knee"])
	lab.run_setup()
	await frames(540)
	check(lab.sequence.history==["Jump","Flip","Land","Dash","Punch","Knee"] and lab.sequence.status=="Combo complete","Six named steps must play in order")
	lab.library_add_buttons.Knee.pressed.emit()
	check(not lab.armed and lab.sequence.history.is_empty(),"Editing playback must safely cancel its queued actions")
	lab.set_chain(["Jump","Twist","Spell Throw","Land"])
	lab.chain_remove_buttons[0].pressed.emit()
	check(lab.chosen_steps().is_empty(),"Removing a prerequisite must clear invalid dependent steps")
	lab.select_category("Knee")
	for i in lab.MAX_CHAIN_STEPS:lab.library_add_buttons.Knee.pressed.emit()
	check(lab.chain_chips.size()==lab.MAX_CHAIN_STEPS and lab.library_add_buttons.Knee.disabled,"Library plus must disable at the chain limit")
	await frames(8)
	check(lab.chain_scroll.get_h_scroll_bar().max_value>lab.chain_scroll.size.x and lab.chain_scroll.scroll_horizontal>0,"Long named chains must scroll and reveal the newest step")
	check(lab.library_add_buttons.Knee.get_global_rect().end.x<=root.get_visible_rect().size.x and lab.remove_step_button.get_global_rect().position.x>=0,"Add and remove controls must remain visible")
	lab.set_chain(["Dash"])
	lab.chain_remove_buttons[0].pressed.emit()
	check(lab.chosen_steps().is_empty() and lab.remove_step_button.disabled,"The final step must be removable to an empty chain")
	lab.remove_chain_step()
	check(lab.chain_chips.is_empty(),"Removing from an empty chain must be safe")
	check(ProjectSettings.get_setting("display/window/size/mode")==DisplayServer.WINDOW_MODE_FULLSCREEN,"Default must be standard borderless fullscreen")
	check(ProjectSettings.get_setting("display/window/size/borderless"),"Window borders must be disabled")
	paused=false
	lab.queue_free()
	await frames(3)
	if failures.is_empty():print("PASS: per-animation plus, named chain without dropdowns, individual removal, duplicates, conditions, playback, scrolling, empty chain and borderless fullscreen configuration")
	quit(0 if failures.is_empty() else 1)
