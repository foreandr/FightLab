extends SceneTree
var failures: Array[String]=[]
func _initialize() -> void:call_deferred("run")
func check(value: bool,message: String) -> void:
	if not value:
		failures.append(message)
		push_error(message)
func frames(count: int) -> void:
	for i in count:await physics_frame
func run() -> void:
	var lab=load("res://scenes/combat_sandbox.tscn").instantiate()
	root.add_child(lab)
	lab.camera_input_enabled=false
	check(lab.chain_menu.size()==2,"Initial dash-knee preset must have exactly two steps")
	lab.add_step_button.pressed.emit()
	check(lab.chain_menu.size()==3 and lab.chosen_steps().size()==3,"Plus button must append an active editable step")
	check(lab.chain_menu[0].selected==1 and lab.chain_menu[1].selected==3,"Adding a step must preserve the existing combo")
	lab.remove_step_button.pressed.emit()
	check(lab.chain_menu.size()==2,"Minus button must remove the last step")
	lab.set_aerial_preset()
	lab.remove_step_button.pressed.emit()
	lab.add_step_button.pressed.emit()
	check(lab.chain_menu[-1].selected==6 and lab.chain_menu[-1].is_item_disabled(1),"A step appended while airborne must inherit aerial choices")
	lab.set_aerial_preset()
	lab.add_step_button.pressed.emit()
	lab.add_step_button.pressed.emit()
	check(lab.chain_menu.size()==6,"Combos must grow beyond the original four slots")
	for i in 6:lab.chain_menu[i].select([4,5,7,1,2,3][i])
	lab.settings_changed()
	lab.run_setup()
	await frames(540)
	check(lab.sequence.history==["Jump","Flip","Land","Dash","Punch","Knee"] and lab.sequence.status=="Combo complete","Extended six-step combo must play all its steps in order")
	lab.add_step_button.pressed.emit()
	check(not lab.armed and paused and lab.sequence.history.is_empty(),"Editing a running combo must reset it safely to ready")
	lab.chain_menu[1].select(0)
	lab.settings_changed()
	lab.add_step_button.pressed.emit()
	check(lab.chain_menu.size()==2 and lab.chosen_steps().size()==2,"Plus after End must create a usable step rather than a disabled trailing slot")
	while lab.chain_menu.size()<lab.MAX_CHAIN_STEPS:lab.add_chain_step()
	check(lab.add_step_button.disabled,"Plus must disable at the bounded editor limit")
	await frames(8)
	check(lab.chain_scroll.get_h_scroll_bar().max_value>lab.chain_scroll.size.x,"Long combos must scroll rather than expand the window")
	check(lab.chain_scroll.scroll_horizontal>0,"Adding a step must reveal the new slot in a long combo")
	check(lab.add_step_button.get_global_rect().end.x<=root.get_visible_rect().size.x and lab.remove_step_button.get_global_rect().position.x>=0,"Add and remove controls must remain inside the viewport")
	lab.set_motion_preset(false)
	check(lab.chain_menu.size()==1 and lab.remove_step_button.disabled,"One-step preset must disable minus")
	lab.remove_chain_step()
	check(lab.chain_menu.size()==1,"Removing the last remaining editor slot must be safe")
	lab.set_aerial_preset()
	check(lab.chain_menu.size()==4 and lab.chosen_steps()==["Jump","Flip","Twist","Land"],"Presets must resize and restore their complete sequence")
	paused=false
	lab.queue_free()
	await frames(3)
	if failures.is_empty():print("PASS: combo plus/minus buttons, preserved steps, conditional append, six-step playback, End handling, bounded scrolling, presets and safe editing")
	quit(0 if failures.is_empty() else 1)
