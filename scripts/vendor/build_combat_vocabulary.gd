   if word in generic_fragments:continue
   if word in ["left","right","front","back","side","high","low","mid","up","down","and","one","two","body","shot","solar","plexus","groin","throat","palm","knifehand","spearhand","ridgehand","heel","axe","chest","hand","leg","head","arm","calf","kneeing","off","in","out","on","or","to","the","a","point","energy","ball","fire","breath","force","power","magic","cast","charge","hold","start","stop","stand","get","hip","shoulder","ankle","drag","cross","check","push","cover","raise","lower","draw","release","sheath","sheathe","unsheathe","break","burst","ground","bow","aim","for","blade","pole","tuck","b","an","throw","opponent","mend","self","chop","cut","chi","ji","fu","tai","tae","kwon","do","arts","art","martial","guarding","shuto","geri","chagi","mawashi","mae","yoko","ushiro","ura","hiza","ap","dollyo","yop","dwi","bakkat","narae","gyaku","oi","kizami","mantis","praying","drunken"]:continue
