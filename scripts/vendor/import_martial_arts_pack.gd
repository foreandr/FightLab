extends SceneTree
## Admit only distinct downloaded combat clips with a usable, moving retarget.
const ROOT="res://assets/animations/community"
const SOURCE="res://work/animation_acquisition/motifect/BVH"
const URL="https://motifect.itch.io/motifect-martial-arts-motion-pack"
const BVH=preload("res://scripts/community_bvh.gd")
class TargetRig extends Node3D:
 var skeleton:Skeleton3D
 var player:AnimationPlayer
 var bones:Dictionary={}
func _initialize():call_deferred("run")
func run():
 var target:=TargetRig.new();root.add_child(target)
 var model=load("res://assets/characters/base/Superhero_Male_FullBody.gltf").instantiate();target.add_child(model)
 target.skeleton=model.find_child("Skeleton3D")
 for i in target.skeleton.get_bone_count():target.bones[target.skeleton.get_bone_name(i)]=i
 target.player=AnimationPlayer.new();model.add_child(target.player);target.player.root_node=NodePath("..")
 var policy=preload("res://scripts/combat_animation_filter.gd").new()
 var catalog:Dictionary=JSON.parse_string(FileAccess.get_file_as_string(ROOT+"/catalog.json"))
 var seen:Dictionary={};var fingerprints:Dictionary={}
 for entry in catalog.entries:seen[str(entry.sha256)]=true
 var accepted:Array=[];var rejected:Array=[]
 var destination:=ROOT+"/raw/motifect_martial_arts"
 DirAccess.make_dir_recursive_absolute(destination)
 DirAccess.make_dir_recursive_absolute("user://community_animations")
 DirAccess.copy_absolute("res://work/animation_acquisition/motifect/README.txt",destination+"/README.txt")
 for filename in DirAccess.get_files_at(SOURCE):
  if filename.get_extension().to_lower()!="bvh":continue
  var input:=SOURCE+"/"+filename
  var sha:=FileAccess.get_sha256(input)
  if seen.has(sha):rejected.append({"file":filename,"reason":"duplicate original file"});continue
  var title:=filename.get_basename().replace("_"," ").capitalize()
  if not policy.accepts({"title":title}):rejected.append({"file":filename,"reason":"not combat relevant"});continue
  var data:=BVH.parse(input)
  if data.has("error"):rejected.append({"file":filename,"reason":data.error});continue
  var mapping:=BVH.mapping(data)
  var complete:=true
  for bone in ["pelvis","Head","upperarm_l","upperarm_r","lowerarm_l","lowerarm_r","hand_l","hand_r","thigh_l","thigh_r","calf_l","calf_r","foot_l","foot_r"]:
   if not mapping.has(bone):complete=false
  if not complete:rejected.append({"file":filename,"reason":"incomplete combat rig"});continue
  var animation:=BVH.retarget(data,target)
  var check:=validate(animation,target)
  if not bool(check.valid):rejected.append({"file":filename,"reason":check.reason});continue
  if fingerprints.has(check.fingerprint):rejected.append({"file":filename,"reason":"duplicate retargeted motion","duplicate_of":fingerprints[check.fingerprint]});continue
  fingerprints[check.fingerprint]=filename
  animation.set_meta("community_import_version",preload("res://scripts/community_animation_catalog.gd").IMPORT_VERSION)
  var resource:="user://community_animations/"+sha+".res"
  if ResourceSaver.save(animation,resource,ResourceSaver.FLAG_COMPRESS)!=OK:rejected.append({"file":filename,"reason":"cannot save verified animation"});continue
  if DirAccess.copy_absolute(input,destination+"/"+filename)!=OK:rejected.append({"file":filename,"reason":"cannot preserve source"});continue
  var tags:Array=[]
  var text:=title.to_lower()
  for word in ["kick","knee","elbow","block","parry","slash","thrust","sweep","sword","spear","staff","judo","wrestling","muay thai","tkd","jump","spin","guard"]:
   if text.contains(word):tags.append(word)
  tags.append_array(["combat","martial arts","motifect","new combat","provider generated","commercial"])
  var entry={"title":title,"original_filename":filename,"description":"Downloaded martial-arts clip; generated by Motifect AI, as disclosed by the creator. Validated on FightLab's humanoid rig.","sha256":sha,"store_asset_id":"download:"+sha,"clip":"community/"+sha,"bvh_source":destination+"/"+filename,"animation_resource":resource,"source_name":"Motifect Martial Arts","source_url":URL,"author":"Motifect","license":"Free personal and commercial project use; no standalone raw redistribution","commercial_use":true,"raw_redistribution":false,"provider_generated":true,"group":"Attack","category":"Martial Arts","step":"Imported Attack","store_raw":true,"downloaded":true,"duration":animation.length,"source_duration":animation.length,"source_timing":"native_v1","frame_count":data.frame_count,"tags":tags,"air_state":"Airborne" if text.contains("jump") else "Grounded","combat_keyword_matches":policy.matches({"title":title}),"validation":check}
  entry.store_animation_type=preload("res://scripts/animation_store_types.gd").kind(entry)
  var id:="source:"+sha
  entry.provenance={"schema":1,"head":id,"nodes":{id:{"id":id,"asset_type":"animation","author":"Motifect","title":title,"operation":"Downloaded original BVH, retargeted and checked for finite moving rig poses","parents":[],"citations":[{"url":URL,"license":entry.license,"original_filename":filename,"sha256":sha,"provider_generated":true}]}}}
  catalog.entries.append(entry);accepted.append({"title":title,"sha256":sha,"duration":animation.length,"validation":check});seen[sha]=true
  print("COMBAT IMPORT: ",title," · ",snappedf(animation.length,0.01)," s")
  await process_frame
 catalog.distinct_count=catalog.entries.size();catalog.updated_utc=Time.get_datetime_string_from_system(true)
 var output:=FileAccess.open(ROOT+"/catalog.json.pending",FileAccess.WRITE);output.store_string(JSON.stringify(catalog));output.close()
 assert(DirAccess.rename_absolute(ProjectSettings.globalize_path(ROOT+"/catalog.json.pending"),ProjectSettings.globalize_path(ROOT+"/catalog.json"))==OK)
 var report:=FileAccess.open("res://work/martial_arts_import_report.json",FileAccess.WRITE)
 report.store_string(JSON.stringify({"source":URL,"accepted":accepted,"rejected":rejected,"checks":"SHA-256 originals, complete limb mapping, finite normalized quaternion keys, sampled moving on-rig poses, bounded limb positions, sampled retarget duplicate fingerprint","limits":"Automated checks cannot prove that all self-contact or pose aesthetics look good."},"  "));report.close()
 print("MARTIAL ARTS IMPORT COMPLETE: ",accepted.size()," accepted; ",rejected.size()," rejected")
 quit()
func validate(animation:Animation,target:TargetRig)->Dictionary:
 if animation==null or animation.length<0.1 or animation.get_track_count()<15:return {"valid":false,"reason":"empty/short/incomplete animation"}
 var quality=preload("res://scripts/animation_quality_gate.gd").inspect(animation,target.skeleton)
 if not bool(quality.ok):return {"valid":false,"reason":quality.reason}
 var baseline:Dictionary={};var movement:=0.0;var signature:=PackedInt32Array()
 var rig:=target.skeleton
 for sample in 21:
  rig.reset_bone_poses()
  var time:=animation.length*sample/20.0
  for track in animation.get_track_count():
   var bone:=rig.find_bone(str(animation.track_get_path(track)).get_slice(":",1))
   if bone<0:return {"valid":false,"reason":"unbound track"}
   if animation.track_get_type(track)==Animation.TYPE_ROTATION_3D:
    var q:=animation.rotation_track_interpolate(track,time);rig.set_bone_pose_rotation(bone,q)
    if q.w<0:q=-q
    for v in [q.x,q.y,q.z,q.w]:signature.append(roundi(v*1000))
   elif animation.track_get_type(track)==Animation.TYPE_POSITION_3D:rig.set_bone_pose_position(bone,animation.position_track_interpolate(track,time))
  rig.force_update_all_bone_transforms()
  var pelvis:=rig.get_bone_global_pose(target.bones.pelvis).origin
  for bone in ["Head","hand_l","hand_r","foot_l","foot_r"]:
   var point:=rig.get_bone_global_pose(target.bones[bone]).origin
   if not point.is_finite() or point.distance_to(pelvis)>2.5:return {"valid":false,"reason":"exploded/invalid body pose"}
   if sample==0:baseline[bone]=point-pelvis
   else:movement=maxf(movement,(point-pelvis).distance_to(baseline[bone]))
 if movement<0.04:return {"valid":false,"reason":"essentially static after retarget"}
 var hash_=HashingContext.new();hash_.start(HashingContext.HASH_SHA256);hash_.update(signature.to_byte_array())
 return {"valid":true,"sampled_limb_movement_m":movement,"samples":21,"mapped_tracks":animation.get_track_count(),"fingerprint":hash_.finish().hex_encode()}
